<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	
	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-crsports</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-crsports.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameInterface.CRSports.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.CRSports.Client</PackageId>
		<Title>Tgs.GameInterface.CRSports.Client</Title>
		<Description>Tgs.GameInterface.CRSports.Client</Description>
		<PackageTags>Tgs GameInterface CRSports Client</PackageTags>
	</PropertyGroup>


	<ItemGroup>
